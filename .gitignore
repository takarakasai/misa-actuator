/target
/.venv
*.bak
# chirp / sysid run outputs
*.csv
# ...except curated bench data referenced by doc/, which is the record of a
# measurement session and cannot be regenerated without the hardware.
!doc/data/*.csv
# scripts/hw_check.sh run logs
/hw_check_logs/

# Vendor manuals (PDF) and vendor SDK checkouts are large binaries kept only
# in the working tree — the markdown transcriptions under ref/*.md are the
# committed reference. Note the 5 PDFs committed before this rule remain
# tracked; .gitignore does not untrack existing files.
crates/*/ref/*.pdf
crates/*/ref/sdk/
