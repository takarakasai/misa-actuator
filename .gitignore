/target
/.venv
*.bak
# chirp / sysid run outputs
*.csv
# ...except curated bench data referenced by doc/, which is the record of a
# measurement session and cannot be regenerated without the hardware.
!doc/data/*.csv
# scripts/hw_check.sh run logs
/hw_check_logs/

# Vendor manuals (PDF) and vendor SDK checkouts are large binaries kept only
# in the working tree — the markdown transcriptions under ref/*.md are the
# committed reference. Note the 5 PDFs committed before this rule remain
# tracked; .gitignore does not untrack existing files.
crates/*/ref/*.pdf
crates/*/ref/sdk/

# GUI front end: npm-managed and generated. `ui/dist` is embedded into the
# Tauri binary at compile time, so building `misa-actuator-gui` needs
# `cd ui && npm ci && npm run build` first — see the README. Every other crate
# builds with nothing but a Rust toolchain (the workspace's `default-members`
# keeps it that way).
/ui/node_modules/
/ui/dist/

# Tauri regenerates these from tauri.conf.json on every build (build.rs calls
# tauri_build::build()), so committing them only produces diff noise whenever
# the config or the Tauri version changes.
/crates/misa-actuator-gui/gen/schemas/

# Stray build transcripts, e.g. `cargo build | Tee-Object -FilePath build.log`,
# and the Vite dev server's redirected output.
/build.log
/ui/vite.log
/ui/vite.err
